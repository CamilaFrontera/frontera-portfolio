---
import '@fontsource/open-sans';

const { title = 'Camila Frontera' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content="Astro" />
		<title>{title}</title>
	</head>
	<body>
		<slot /> 
	</body>
</html>

<style>
	:global(*),
	:global(*::before),
	:global(*::after) {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		overflow-x: clip;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
