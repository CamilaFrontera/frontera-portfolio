
---
import { Icon } from 'astro-icon/components';
import Header from './Header.astro';
import About from './About.astro';
import Habilidades from './Skills.astro';
import Experiencia from './Experience.astro';
import Educación from './Education.astro';
import Contacto from './Contact.astro';
---

<Header />
<div class="page">
	<main class="hero" id="inicio">
		<div class="hero-content">
			<div class="hero-text">
				<p class="eyebrow">QA Automation Engineer</p>
				<h1>Hola, soy Camila</h1>
				<p class="description">
					Especialista en automatización de pruebas con Playwright y Karate. 5+ años en el sector bancario y financiero transformando tareas manuales en procesos automatizados.
				</p>
				<div class="cta-group">
					<a class="cta" href="#perfil-laboral"><Icon name="mdi:briefcase-outline" /> Mi experiencia</a>
					<a class="cta" href="#contacto"><Icon name="mdi:email-outline" /> Contactarme</a>
					<a class="cta cta-secondary" href="https://github.com/CamilaFrontera" target="_blank" rel="noopener noreferrer"><Icon name="mdi:github" /> Mi GitHub</a>
				</div>
			</div>
			<div class="hero-photo">
				<img src="/mi-foto.jpg" alt="Foto de Camila" />
			</div>
		</div>
	</main>
	<About />
	<Experiencia />
	<Habilidades />
	<Educación />
	<Contacto />
</div>

<style>
	:global(html), :global(body) {
		margin: 0;
		min-height: 100%;
		font-family: 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
	}

	:global(html) {
		background: #2f3aef;
	}

	/* Fondo fijo al viewport: no se repite ni se corta al hacer scroll en páginas largas (mobile) */
	:global(body)::before {
		content: '';
		position: fixed;
		inset: 0;
		z-index: -1;
		background: linear-gradient(135deg, #2f3aef, #b94eff, #ff6ec7, #26d0ce);
		background-size: 400% 400%;
		animation: gradientMove 15s ease infinite;
	}

	.page {
		position: relative;
		font-family: Inter, Roboto, 'Helvetica Neue', Arial, sans-serif;
		color: white;
		padding-top: var(--header-height, 88px);
	}

	/* Cada sección tiene su propio fondo a todo el ancho, así el cambio de fondo coincide con el cambio de contenido */
	.page > :global(section) {
		padding-inline: max(2rem, calc((100% - 1000px) / 2));
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	.page > :global(section:nth-of-type(odd)) {
		background: rgba(14, 16, 54, 0.35);
	}

	.page > :global(section:nth-of-type(even)) {
		background: rgba(14, 16, 54, 0.2);
	}

	.hero {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: calc(100vh - var(--header-height, 88px));
		padding: 4rem 3rem;
		width: 100%;
		scroll-margin-top: var(--header-height, 88px);
	}

	.hero-content {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 3rem;
		align-items: center;
		width: 100%;
		max-width: 1200px;
	}

	.hero-text {
		max-width: 600px;
	}

	.hero-photo {
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.hero-photo img {
		width: min(100%, 350px);
		aspect-ratio: 1 / 1;
		object-fit: cover;
		border-radius: 1.5rem;
		border: 2px solid rgba(255, 255, 255, 0.3);
		box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.3em;
		font-size: 0.85rem;
		opacity: 0.85;
		margin: 0 0 1rem;
	}

	h1 {
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		line-height: 1.02;
		margin: 0 0 1.25rem;
		max-width: 10ch;
	}

	.description {
		font-size: 1.1rem;
		line-height: 1.8;
		max-width: 40rem;
		margin: 0 0 2rem;
		opacity: 0.95;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 1rem 1.75rem;
		background: rgba(255, 255, 255, 0.14);
		backdrop-filter: blur(18px);
		border: 1px solid rgba(255, 255, 255, 0.24);
		border-radius: 999px;
		color: white;
		text-decoration: none;
		font-weight: 600;
		transition: transform 0.2s ease, background 0.2s ease;
	}

	.cta svg {
		width: 1.2em;
		height: 1.2em;
	}

	.cta:hover {
		transform: translateY(-2px);
		background: rgba(255, 255, 255, 0.22);
	}

	.cta-group {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.cta-secondary {
		background: rgba(100, 181, 246, 0.2);
		border-color: rgba(100, 181, 246, 0.5);
	}

	.cta-secondary:hover {
		background: rgba(100, 181, 246, 0.3);
		border-color: rgba(100, 181, 246, 0.7);
	}

	@keyframes gradientMove {
		0% {
			background-position: 0% 50%;
		}
		50% {
			background-position: 100% 50%;
		}
		100% {
			background-position: 0% 50%;
		}
	}

	@media (max-width: 768px) {
		.page > :global(section) {
			padding-inline: 1.5rem;
		}

		.hero {
			padding: 3rem 1.5rem;
		}
		
		.hero-content {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		
		h1 {
			font-size: clamp(2.5rem, 10vw, 3.5rem);
		}

		.eyebrow {
			font-size: 0.95rem;
		}

		.description {
			font-size: 1.15rem;
		}

		.cta {
			font-size: 1.05rem;
		}

		.hero-text {
			margin-inline: auto;
			text-align: center;
		}

		h1,
		.description {
			margin-inline: auto;
		}

		.cta-group {
			flex-direction: column;
		}

		.cta {
			width: 100%;
		}
	}
</style>
