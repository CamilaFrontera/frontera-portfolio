---
import { Icon } from 'astro-icon/components';
---

<section class="section" id="contacto">
  <h2>Contactarme</h2>
  <div class="contact-container">
    <p class="contact-intro">¿Te interesa colaborar o tienes alguna pregunta? ¡Me encantaría escucharte!</p>

    <div class="contact-options">
      <button id="email-btn" class="contact-card email-card">
        <div class="contact-icon"><Icon name="mdi:email-outline" /></div>
        <h3>Email</h3>
        <p>camilasofiafront@gmail.com</p>
        <span class="contact-action">Copiar correo</span>
      </button>

      <a href="https://www.linkedin.com/in/camilafrontera" target="_blank" rel="noopener noreferrer" class="contact-card linkedin-card">
        <div class="contact-icon"><Icon name="mdi:linkedin" /></div>
        <h3>LinkedIn</h3>
        <p>linkedin.com/in/camilafrontera</p>
        <span class="contact-action">Visitar perfil <Icon name="mdi:arrow-right" /></span>
      </a>

    </div>

    <div id="copy-notification" class="copy-notification">
      ✓ Email copiado al portapapeles
    </div>
  </div>
</section>

<style>
  .section {
    padding: 5rem 2rem 6rem;
    color: white;
    scroll-margin-top: var(--header-height, 88px);
  }

  h2 {
    margin-bottom: 2rem;
    font-size: 2rem;
    text-align: center;
  }

  .contact-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-intro {
    font-size: 1.15rem;
    line-height: 1.8;
    margin-bottom: 3rem;
    opacity: 0.95;
    max-width: 500px;
    text-align: center;
  }

  .contact-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 2rem;
    width: 100%;
    margin-bottom: 3rem;
  }

  .contact-card {
    padding: 2.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    text-decoration: none;
    color: white;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .contact-card:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-8px);
  }

  .contact-card.email-card:hover {
    border-color: rgba(255, 107, 107, 0.5);
    background: rgba(255, 107, 107, 0.1);
  }

  .contact-card.linkedin-card:hover {
    border-color: rgba(0, 119, 181, 0.5);
    background: rgba(0, 119, 181, 0.1);
  }

  .contact-icon {
    font-size: 2.5rem;
    font-weight: bold;
    margin-bottom: 1rem;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
  }

  .contact-icon svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .contact-action svg {
    width: 1em;
    height: 1em;
    vertical-align: -0.15em;
  }

  .contact-card h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.35rem;
    font-weight: 700;
  }

  .contact-card p {
    margin: 0 0 1.5rem 0;
    font-size: 0.95rem;
    opacity: 0.85;
    word-break: break-all;
  }

  .contact-action {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .contact-card:hover .contact-action {
    background: rgba(255, 255, 255, 0.25);
  }

  #email-btn {
    cursor: pointer;
    padding: 2.5rem;
    font-family: inherit;
  }

  #email-btn:active {
    transform: scale(0.98);
  }

  .copy-notification {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%) translateY(150px);
    background: rgba(76, 175, 80, 0.95);
    color: white;
    padding: 1rem 2rem;
    border-radius: 0.75rem;
    font-weight: 600;
    pointer-events: none;
    opacity: 0;
    transition: all 0.3s ease;
    z-index: 1000;
  }

  .copy-notification.show {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }

  @media (max-width: 768px) {
    .section {
      padding: 3rem 1.5rem 4rem;
    }

    h2 {
      font-size: 1.75rem;
    }

    .contact-intro {
      font-size: 1.1rem;
      margin-bottom: 2rem;
    }

    .contact-card p {
      font-size: 1.05rem;
    }

    .contact-action {
      font-size: 1rem;
    }

    .contact-options {
      gap: 1.5rem;
    }

    .contact-card {
      padding: 2rem;
    }
  }
</style>

<script>
  const emailBtn = document.getElementById('email-btn');
  const notification = document.getElementById('copy-notification');
  const emailAddress = 'camilasofiafront@gmail.com';

  if (emailBtn && notification) {
    emailBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(emailAddress);
        
        // Mostrar notificación
        notification.classList.add('show');
        
        // Ocultar notificación después de 3 segundos
        setTimeout(() => {
          notification.classList.remove('show');
        }, 3000);
      } catch (err) {
        // Fallback si clipboard API no está disponible
        const textArea = document.createElement('textarea');
        textArea.value = emailAddress;
        document.body.appendChild(textArea);
        textArea.select();
        document.execCommand('copy');
        document.body.removeChild(textArea);
        
        notification.classList.add('show');
        setTimeout(() => {
          notification.classList.remove('show');
        }, 3000);
      }
    });
  }
</script>
